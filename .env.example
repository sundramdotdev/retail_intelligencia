# ==============================================================================
# RETAIL INTELLIGENCIA — Root Environment Configuration Template
# ==============================================================================

# Environment mode ('dev', 'staging', 'prod')
ENVIRONMENT=dev

# Edge Device Configuration
EDGE_DEVICE_ID=edge-dev-001
EDGE_STORE_ID=store_001
EDGE_PROVISIONING_KEY=demo_provisioning_key_2026
EDGE_DEVICE_TOKEN=devkey_edge_001_secret

# MQTT Broker (Phase 4 Edge -> Gateway)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=edge-dev-001

# FastAPI Device Gateway (Phase 5)
API_PORT=8000
API_HOST=0.0.0.0
FASTAPI_GATEWAY_URL=http://localhost:8000
# Next.js Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# TypeScript Data Service & Prisma (Phase 5)
DATA_SERVICE_PORT=5000
DATA_SERVICE_HOST=0.0.0.0
DATA_SERVICE_URL=http://localhost:5000

# PostgreSQL Database (Phase 5)
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=retail_secure_password_2026
POSTGRES_DB=retail_intelligencia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://retail_admin:retail_secure_password_2026@localhost:5432/retail_intelligencia?schema=public
